# ---------------------------------------------------------------------------
# guideline-gpt-evals configuration. Copy to `.env` and fill in your keys.
#
# NOTE: No keys are needed just to BROWSE results (the dashboard reads
# pre-computed JSON). Keys are only required to RE-RUN experiments.
# ---------------------------------------------------------------------------

# --- LLM-as-judge -----------------------------------------------------------
# The judge must be a STRONGER model than the system under test (spec §5.3).
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-opus-4-7

# --- Provider credentials ---------------------------------------------------
# Required if JUDGE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Always required to run experiments (embeddings via guideline-gpt), and used
# for the judge when JUDGE_PROVIDER=openai.
OPENAI_API_KEY=

# --- Paths ------------------------------------------------------------------
RESULTS_DIR=./results
EVAL_DATASET_PATH=./eval_dataset/questions.jsonl
JUDGE_CACHE_DIR=./.judge_cache

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
